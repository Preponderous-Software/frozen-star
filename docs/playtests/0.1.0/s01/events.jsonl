{"type": "dialogue", "tick": 142, "wallTimeMs": 1794715923789, "who": "YOU", "text": "(Falling. No wind, no sound.)"}
{"type": "dialogue", "tick": 1500, "wallTimeMs": 1794716115248, "who": "YOU", "text": "(The black is spreading. The light is all overhead now.)"}
{"type": "dialogue", "tick": 1641, "wallTimeMs": 1794716136906, "who": "YOU", "text": "(Nothing happened.)"}
