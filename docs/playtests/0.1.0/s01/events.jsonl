{"type": "card", "tick": 1707, "wallTimeMs": 1794716143849, "title": "Frozen Star", "subtitle": "Research vessel Tern \u00b7 10 Schwarzschild radii above Erebus"}
{"type": "dialogue", "tick": 1800, "wallTimeMs": 1794716147065, "who": "WREN", "text": "Good morning, Doctor. It is 06:40, ship time."}
{"type": "dialogue", "tick": 2269, "wallTimeMs": 1794716173381, "who": "WREN", "text": "We reached station above Erebus at 04:12. Ten Schwarzschild radii out, holding steady."}
